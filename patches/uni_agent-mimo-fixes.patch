+    async def _timeout_trajectories(
+        self,
+        *,
+        session_id: str,
+        partial_trajectories: list[Trajectory],
+        failure_info: dict[str, object],
+        runner_config: _RunnerConfig,
+        sample_fields: dict[str, object],
+        sample_index: int,
+        session_index: int,
+        runner_name: str,
+        run_dir,
+    ) -> tuple[list[Trajectory], dict[str, object]]:
+        """Keep a timed-out session's captured trajectory as a scored-0 failure.
+
+        ``Session.abort`` says its snapshot must not be scored or enqueued. It is built by the
+        same ``_materialize_active_chains`` as ``finalize`` (identical fields: tokens, logprobs,
+        routed experts, weight-version span); what it lacks is a runner-posted reward, which
+        this method supplies (0). Completed generations are kept; a request in flight at the
+        abort is not part of the snapshot.
+        """
+        selected = _select_session_trajectories(session_id, partial_trajectories, runner_config.trajectory_selection)
+        info = {**failure_info, "reward": 0.0, "gradable": True, "timeout_as_failure": True}
+        result = [
+            replace(
+                traj,
+                reward_info=dict(info),
+                reward_score=0.0,
+                extra_fields={**traj.extra_fields, "reward_extra_info": {"timeout_as_failure": 1.0}},
+            )
+            for traj in selected
+        ]
+        result = self._annotate_repetition(session_id, result)
+        logger.warning(
+            "session %s timed out (%s); keeping %d partial trajectory(ies) scored 0",
+            session_id,
+            failure_info.get("termination_kind"),
+            len(result),
+        )
+        if run_dir is not None:
+            await asyncio.to_thread(self._dump_trajectories, run_dir, session_id, result)
+            await asyncio.to_thread(
+                self._dump_session_manifest,
+                run_dir,
+                session_id,
+                sample_fields,
+                sample_index,
+                session_index,
+                runner_name,
+                result,
+                failure_info,
+            )
+        return result, sample_fields
+
